{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b4u-lapar-wheel",
  "compatibility_date": "2026-10-01",
  // The near me API (worker/index.ts). It only runs for /lapar-wheel/api/*.
  "main": "worker/index.ts",
  // dist/ holds the export under lapar-wheel/ (see scripts/nest-out.mjs),
  // because Workers static assets match the full request path.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /lapar-wheel serves lapar-wheel/index.html, matching next/link (no trailing slash).
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/lapar-wheel/api/*"]
  },
  // One Durable Object for the per-IP rate limit and the daily cap on Google calls (worker/limits.ts).
  // SQLite-backed, the only kind on the Free plan.
  "durable_objects": {
    "bindings": [{ "name": "LIMITS", "class_name": "Limits" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limits"] }],
  // No Workers Logs: requests carry locations, and nothing about them is kept.
  "observability": { "enabled": false },
  // Routes, not a custom domain: the hostname belongs to the Built4You hub,
  // whose DNS record these routes need.
  "routes": [
    { "pattern": "built4you.jasperntc.dev/lapar-wheel", "zone_name": "jasperntc.dev" },
    { "pattern": "built4you.jasperntc.dev/lapar-wheel/*", "zone_name": "jasperntc.dev" }
  ]
}
