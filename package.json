{
  "name": "b4u-lapar-wheel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/nest-out.mjs && vitest run --config vitest.build.config.ts",
    "start": "next start",
